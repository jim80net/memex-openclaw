{
  "name": "@jim80net/memex-openclaw",
  "version": "0.8.0",
  "description": "Memex skill/memory/rule router for OpenClaw — vector-based semantic injection powered by @jim80net/memex-core",
  "license": "MIT",
  "author": "General-ML",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/jim80net/memex-openclaw.git"
  },
  "homepage": "https://github.com/jim80net/memex-openclaw#readme",
  "bugs": {
    "url": "https://github.com/jim80net/memex-openclaw/issues"
  },
  "keywords": [
    "memex",
    "openclaw",
    "plugin",
    "skill-router",
    "vector-search",
    "embeddings",
    "rag"
  ],
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "lint": "biome check src/ test/",
    "lint:fix": "biome check --write src/ test/",
    "format": "biome format --write src/ test/",
    "format:check": "biome format src/ test/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "verify:lock-policy": "node scripts/verify-lock-policy.mjs",
    "verify:core-security": "node scripts/verify-core-security.mjs",
    "project-rules": "node --experimental-strip-types scripts/project-rules.mjs",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.7",
    "@types/node": "^25.3.1",
    "lefthook": "^2.1.4",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^3.8.1"
  },
  "dependencies": {
    "@huggingface/jinja": "^0.5.3",
    "@jim80net/memex-core": "^0.7.3",
    "onnxruntime-node": "1.21.0",
    "onnxruntime-web": "1.22.0-dev.20250409-89f8206ba4",
    "sharp": "0.35.3"
  },
  "bundleDependencies": [
    "@huggingface/transformers",
    "@jim80net/memex-core"
  ],
  "pnpm": {
    "overrides": {
      "@huggingface/transformers>sharp": "0.35.3",
      "@protobufjs/utf8": "1.1.2",
      "protobufjs": "7.6.5",
      "tar": "7.5.22"
    },
    "patchedDependencies": {
      "@huggingface/transformers@3.8.1": "patches/@huggingface__transformers@3.8.1.patch",
      "@jim80net/memex-core@0.7.3": "patches/@jim80net__memex-core@0.7.3.patch"
    }
  }
}
